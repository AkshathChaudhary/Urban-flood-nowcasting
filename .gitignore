# ============================================================
# Virtual Environments
# ============================================================
venv/
.venv/
env/
.env/
ENV/

# ============================================================
# Python cache & compiled bytecode
# ============================================================
__pycache__/
**/__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
*$py.class
*.so

# ============================================================
# Distribution / Packaging
# ============================================================
dist/
build/
*.egg-info/
*.egg
*.whl

# ============================================================
# Testing & Coverage
# ============================================================
.pytest_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# ============================================================
# Logs & Runtime
# ============================================================
*.log
logs/
*.sqlite
*.sqlite3

# ============================================================
# Environment & Secrets — NEVER commit real credentials
# ============================================================
.env
.env.local
.env.*.local
# .env.example is intentionally NOT ignored (safe template)

# ============================================================
# IDE & Editor files
# ============================================================
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ============================================================
# OS files
# ============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# ============================================================
# Jupyter
# ============================================================
.ipynb_checkpoints/

# ============================================================
# Temporary & workspace caches
# ============================================================
.freebuff/
.planning/
tmp/
temp/
scratch/
*.tmp

# ============================================================
# Node / Frontend
# ============================================================
node_modules/
**/node_modules/
frontend/dist/
frontend/.cache/
.parcel-cache/

# ============================================================
# Large generated data & binary assets
# (corridor DEM grids, simulation PNGs, radar tiles, viz exports)
# ============================================================

# NumPy elevation grids — large binary files
backend/data/cities/**/dem/elevation_grid.npy

# Generated simulation & radar images
backend/data/*.png
backend/data/**/*.png
outputs/
backend/data/viz/

# Radar tile cache
backend/data/radar_tiles/

# Heavy viz export (simulation_data.json can be multi-MB)
backend/data/viz/simulation_data.json

# OSM waterbody cache (auto-regenerated)
backend/data/osm_waterbodies.json

# ============================================================
# Model weights & large ML artifacts (if added later)
# ============================================================
*.h5
*.hdf5
*.pkl
*.joblib
*.pt
*.pth
*.onnx
*.safetensors
models/weights/
backend/models/weights/

# ============================================================
# Docker
# ============================================================
.dockerignore
docker-compose.override.yml
